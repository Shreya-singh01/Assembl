# ---- Backend (backend/.env or Render environment) ----------------------------
ENVIRONMENT=development                 # development | test | production
MONGODB_URL=memory://                   # memory:// = in-process mock, NOT persisted. Production: mongodb+srv://... (MongoDB Atlas)
MONGODB_DB=assembl
REDIS_URL=                              # optional; empty = in-process rate limiting (single instance)

SESSION_COOKIE_NAME=assembl_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false                     # MUST be true in production (enforced at startup)
COOKIE_SAMESITE=lax                     # lax with a same-site deployment (see docs/deployment.md)
COOKIE_DOMAIN=                          # e.g. .example.com when app. and api. share a parent domain

CORS_ORIGINS=http://localhost:5173      # comma-separated frontend origins
ADMIN_EMAILS=                           # comma-separated; these accounts get the research-admin role

EMBEDDING_BACKEND=sbert                 # sbert | hashing (hashing is NOT semantic: tests/offline only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

SEED_DEMO=0                             # 1 = insert labelled synthetic demo users at startup (never in production)

# ---- Frontend (frontend/.env.local or Vercel) --------------------------------
VITE_API_BASE=                          # empty = same origin (Vite proxy locally, Vercel rewrite in production)
VITE_SOCKET_URL=                        # empty = same origin
VITE_SOCKET_TRANSPORTS=websocket,polling  # use "polling" behind proxies without WebSocket support (e.g. Vercel rewrites)
